{
  "name": "yt-telebot",
  "version": "1.0.0",
  "description": "Telegram bot for uploading videos directly to YouTube with simple Google sign-in",
  "main": "server.js",
  "type": "module",
  "scripts": {
    "start": "node server.js",
    "bot": "node src/bot.js",
    "dev": "node -e \"import('./server.js'); import('./src/bot.js');\"",
    "deploy": "vercel --prod"
  },
  "dependencies": {
    "dotenv": "^16.4.7",
    "googleapis": "^144.0.0",
    "mongodb": "^7.8.0",
    "telegraf": "^4.16.3"
  }
}
